# interdependent-api environment template.
# Copy to .env and fill in real values. Every variable in the env schema
# (src/config/env.js) is listed here — test/envExample.test.js enforces that,
# so adding a schema key means adding a line here too.

# ── Server ───────────────────────────────────────────────────────────────────
PORT=3001

# ── Anthropic ────────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-your-key-here
# NOTE: there is deliberately NO ANTHROPIC_MODEL variable. The evaluation model
# is pinned in src/config/env.js (operator decision, 2026-06-10) so a stale
# dashboard env var can't override it; setting ANTHROPIC_MODEL only logs a
# warning that it is ignored. To change models, edit env.js.

# ── Supabase ─────────────────────────────────────────────────────────────────
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ── Auth ─────────────────────────────────────────────────────────────────────
# Exactly 4 characters.
SUBMISSION_PASSCODE=0000
# Real random secret (min 16 chars): openssl rand -hex 32
# Placeholder-looking values ("change-me…") log a loud warning and refuse to
# start when NODE_ENV=production.
JWT_SECRET=change-me-generate-a-real-secret
# Seconds.
JWT_EXPIRY=86400

# ── CORS ─────────────────────────────────────────────────────────────────────
# Comma-separated exact origins. The Cloudflare Pages fallback origin
# (https://interdependent-studio.pages.dev) is always allowed in addition to
# this list — see src/middleware/cors.js; hashed deploy previews are not.
CORS_ORIGINS=https://www.interdependent.studio,https://interdependent.studio

# ── Email (Resend) ───────────────────────────────────────────────────────────
RESEND_API_KEY=re_your-key-here
EMAIL_FROM=noreply@interdependent.studio
# Optional: where admin notifications go.
ADMIN_EMAIL=

# ── Passkeys / WebAuthn ──────────────────────────────────────────────────────
RP_ID=interdependent.studio
RP_NAME=Interdependent Studio
# Seconds; 5 min default.
ACTION_TOKEN_EXPIRY=300

# ── Read-first / Curator model ───────────────────────────────────────────────
# Long-lived reader identity (read personalization only; NOT writes).
READER_SESSION_EXPIRY=30d
# XP at/above which a reader is a Curator — "the magic number".
CURATOR_MIN_XP=1724
# Comma-separated always-Curator staff handles (must already be registered).
ADMIN_HANDLES=christopher-amell,abhinav-vadhera

# ── Featured script (event perk gate) ────────────────────────────────────────
# Optional explicit id; when unset, the first script whose title contains
# FEATURED_SCRIPT_TITLE (default "carrier") is used.
FEATURED_SCRIPT_ID=
FEATURED_SCRIPT_TITLE=carrier
